{
  "name": "@onerlaw/agentic-eslint-plugin",
  "version": "0.0.0-semantically-released",
  "description": "ESLint guard rules that mechanize conventions agents keep breaking \u2014 each rule born from a defect that actually shipped.",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "lint",
    "static-analysis",
    "code-quality",
    "convention",
    "guard-rules"
  ],
  "homepage": "https://github.com/onerlaw/agentic-eslint-plugin#readme",
  "bugs": {
    "url": "https://github.com/onerlaw/agentic-eslint-plugin/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onerlaw/agentic-eslint-plugin.git"
  },
  "license": "MIT",
  "author": "Derek Honerlaw",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "verify:pack": "node scripts/verify-pack.mjs",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "eslint": ">=9"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.18.0",
    "@semantic-release/npm": "^13.1.5",
    "@types/node": "^26.2.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@typescript-eslint/types": "^8.67.0",
    "eslint": "^9.18.0",
    "jiti": "^2.6.1",
    "semantic-release": "^25.0.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "types": "./dist/index.d.ts"
}
